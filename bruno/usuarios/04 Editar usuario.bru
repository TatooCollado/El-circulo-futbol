meta {
  name: 04 Editar usuario
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/users/{{userId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Usuario",
    "apellido": "Bruno Editado",
    "email": "usuario.bruno@demo.com",
    "password": "",
    "rol": "admin",
    "activo": true
  }
}

assert {
  res.status: eq 200
  res.body.user.rol: eq admin
}

