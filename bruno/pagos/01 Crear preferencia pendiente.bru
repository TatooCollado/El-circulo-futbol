meta {
  name: 01 Crear preferencia pendiente
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/pagos/crear-preferencia
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reservaId": "{{reservaId}}"
  }
}

docs {
  Crea una preferencia simulada para una reserva pendiente.
}

assert {
  res.status: eq 200
  res.body.pago.id: isDefined
}
