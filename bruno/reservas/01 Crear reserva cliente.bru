meta {
  name: 01 Crear reserva cliente
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/reservas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "canchaId": "{{canchaId}}",
    "fecha": "{{fechaReserva}}",
    "momento": "{{momentoReserva}}"
  }
}

vars:post-response {
  reservaId: res.body.reserva.id
}

assert {
  res.status: eq 201
  res.body.reserva.estado: eq pendiente_pago
  res.body.reserva.Pago.estado: eq pendiente
}
