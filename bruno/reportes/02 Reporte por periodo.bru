meta {
  name: 02 Reporte por periodo
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/reportes/general?fechaDesde={{fechaDesdeReporte}}&fechaHasta={{fechaHastaReporte}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.filtros.diasPeriodo: isNumber
  res.body.resumen.ocupacionPromedio: isDefined
  res.body.reservasPorMomento: isDefined
}
