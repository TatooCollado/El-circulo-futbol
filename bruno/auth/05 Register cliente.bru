meta {
  name: 05 Register cliente
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Cliente",
    "apellido": "Nuevo",
    "email": "cliente.nuevo@demo.com",
    "password": "Demo1234"
  }
}

vars:post-response {
  token: res.body.token
}

assert {
  res.status: eq 201
  res.body.user.rol: eq cliente
}

